generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Student {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  phone           String?
  birthdate       DateTime?
  city            String?
  goal            String?
  level           String     @default("iniciante")
  daysPerWeek     Int        @default(3)
  sessionDuration Int        @default(60)
  restrictions    String?
  equipment       String?
  notes           String?
  status          String     @default("ativo")
  mfitId          String?
  lastContactAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  photos          Photo[]
  workouts        Workout[]
  followUps       FollowUp[]
}

model FormResponse {
  id         String   @id @default(cuid())
  rawData    String
  status     String   @default("novo")
  studentId  String?
  receivedAt DateTime @default(now())
}

model Photo {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  url       String
  angle     String?
  takenAt   DateTime @default(now())
}

model Workout {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String
  content      String
  status       String           @default("rascunho")
  mfitSyncedAt DateTime?
  createdAt    DateTime         @default(now())
  sessions     WorkoutSession[]
}

model WorkoutSession {
  id        String     @id @default(cuid())
  workoutId String
  workout   Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  exercises Exercise[]
}

model Exercise {
  id        String         @id @default(cuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  sets      Int
  reps      String
  rest      Int            @default(60)
  notes     String?
  order     Int
}

model FollowUp {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message       String
  channel       String   @default("email")
  status        String   @default("enviado")
  autoGenerated Boolean  @default(false)
  sentAt        DateTime @default(now())
}

model Settings {
  id                 String  @id @default(cuid())
  jotformSecret      String?
  zapiToken          String?
  zapiInstance       String?
  zapiPhone          String?
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPass           String?
  smtpFrom           String?
  followUpTemplate   String?
  autoFollowUp       Boolean @default(false)
  followUpHour       Int     @default(8)
  workoutPreferences String?
}
